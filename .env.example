# GigaChat authorization key. Required: the service does not start without it.
GIGACHAT_TOKEN=

# Optional overrides. Defaults work for the intended model.
# GIGACHAT_ULTRA_BASE_URL=https://api.giga.chat/v1
# GIGACHAT_ULTRA_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_LLM_MODEL=GigaChat-3-Ultra
# GIGACHAT_LLM_TEMPERATURE=0.1
# GIGACHAT_LLM_MAX_TOKENS=5000
# GIGACHAT_VERIFY_SSL_CERTS=false
# GIGACHAT_TIMEOUT=60.0

# HTTP server bind settings.
# SIGNALS_HOST=0.0.0.0
# SIGNALS_PORT=8000
